# Copiar a .env.local (gitignored) para desarrollo local.
# Sin nada de esto configurado, el frontend igual arranca y usa los
# valores por defecto de KleySites (kleysite.dev) — solo hace falta
# completar esto si estás corriendo tu propio backend/Cloudinary/Google.

# URL del backend. Con el backend local corriendo (ver server/README.md):
VITE_API_BASE=http://localhost:8787/api

# Cloudinary (fotos de perfil, favicons, miniaturas) — creá una cuenta
# gratis en cloudinary.com y un "upload preset" sin firmar (Settings →
# Upload → Upload presets → Add upload preset → Signing Mode: Unsigned).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (tipo "Web application"), para el botón "Continuar con Google".
VITE_GOOGLE_CLIENT_ID=
